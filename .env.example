# --- Database (Neon: Dashboard -> Connect -> pooled connection) ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Login (single recruiter account) ---
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
# Random string, at least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# --- Email (optional). Without a key, emails are printed to the server console ---
RESEND_API_KEY=""
EMAIL_FROM="Mini ATS <onboarding@resend.dev>"
# Where "new candidate" alerts go. Defaults to ADMIN_EMAIL
NOTIFY_EMAIL=""
# Public URL of the app, used for links in emails
APP_URL="http://localhost:3000"
