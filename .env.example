# --- Database (Neon: Dashboard -> Connect -> pooled connection) ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Login (recruiter account created via seed; env admin is fallback) ---
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
# Random string, at least 32 characters. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# --- Email (Resend). Without RESEND_API_KEY, emails print to the server console. ---
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Must be a verified sender in Resend (or your own domain)
EMAIL_FROM="Mini ATS <onboarding@resend.dev>"
# Where "new candidate" alerts go (recruiter inbox). Falls back to ADMIN_EMAIL if empty
NOTIFY_EMAIL="you@example.com"
# Public URL of the app — used for links inside emails (set to your Vercel URL in prod)
APP_URL="https://your-app.vercel.app"

# ===========================
# Vercel: Project Settings -> Environment Variables
# Add ALL of the above for Production, Preview and Development.
# After changing env vars, redeploy for them to take effect.
# ===========================
